# iOS 15.0 is the floor imposed by our dependencies:
#   GoogleMaps 9.4.0, Google-Maps-iOS-Utils 6.1.0 and Firebase 12.6.0 all declare `ios: 15.0`.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # flutter_additional_ios_build_settings pins pods back to Flutter's default
      # (13.0), which is below what GoogleMaps/Firebase require.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # permission_handler compiles every permission handler by default. App Store
      # review rejects binaries that reference permission APIs with no matching
      # usage string (ITMS-90683), so only compile in the ones this app asks for.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] += [
        'PERMISSION_LOCATION=1',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_NOTIFICATIONS=1',
      ]
    end
  end

  # ── Vendored xcframework dSYMs ──────────────────────────────────────────────
  # Xcode unpacks every xcframework belonging to one pod into a single staging
  # directory (XCFrameworkIntermediates/<pod>/). When a pod vendors more than one
  # xcframework and each ships its own dSYMs/ folder, the later one REPLACES the
  # earlier — so razorpay-core-pod loses Razorpay.framework.dSYM to
  # RazorpayCore.framework.dSYM, and App Store Connect reports the missing UUID.
  #
  # Copy the dSYMs into the archive ourselves, straight from the pod, which is
  # unaffected by the collision.
  user_project = installer.aggregate_targets.first.user_project
  runner = user_project.targets.find { |t| t.name == 'Runner' }
  phase_name = '[FITKHAO] Copy vendored xcframework dSYMs'
  runner.build_phases.delete_if do |phase|
    phase.respond_to?(:name) && phase.name == phase_name
  end
  phase = runner.new_shell_script_build_phase(phase_name)
  phase.shell_script = <<~SCRIPT
    set -euo pipefail

    # Only archives/release builds carry dSYMs.
    [ "${DEBUG_INFORMATION_FORMAT:-}" = "dwarf-with-dsym" ] || exit 0
    [ -n "${DWARF_DSYM_FOLDER_PATH:-}" ] || exit 0
    mkdir -p "${DWARF_DSYM_FOLDER_PATH}"

    # Device and simulator slices ship dSYMs with identical names but different
    # UUIDs, so pick the slice matching what we are building.
    if [ "${PLATFORM_NAME}" = "iphonesimulator" ]; then
      slice_filter="simulator"
    else
      slice_filter="device"
    fi

    find "${PODS_ROOT}" -type d -name '*.framework.dSYM' -path '*.xcframework/*' | while read -r dsym; do
      case "$dsym" in
        *-simulator/*) [ "$slice_filter" = "simulator" ] || continue ;;
        *)             [ "$slice_filter" = "device" ]    || continue ;;
      esac

      name="$(basename "$dsym")"
      dest="${DWARF_DSYM_FOLDER_PATH}/${name}"
      if [ -d "$dest" ]; then continue; fi

      # Only ship a dSYM whose UUID matches a binary actually embedded in the app.
      binary_name="${name%.framework.dSYM}"
      embedded="${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}/${binary_name}.framework/${binary_name}"
      [ -f "$embedded" ] || continue

      dwarf="${dsym}/Contents/Resources/DWARF/${binary_name}"
      [ -f "$dwarf" ] || continue
      if [ "$(dwarfdump --uuid "$dwarf" | awk '{print $2}' | sort -u)" \
         != "$(dwarfdump --uuid "$embedded" | awk '{print $2}' | sort -u)" ]; then
        continue
      fi

      echo "Copying missing dSYM: ${name}"
      cp -R "$dsym" "${DWARF_DSYM_FOLDER_PATH}/"
    done
  SCRIPT
  phase.run_only_for_deployment_postprocessing = '0'
  user_project.save
end
